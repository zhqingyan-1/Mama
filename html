<!DOCTYPE html>
<html>
<head>
    <title>Best Wishes</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div id="envelope-section">
    <div class="envelope">✉️</div>
    <button onclick="openLetter()">Open</button>
</div>

<div id="letter-section" class="hidden">
    <div class="letter">
        <h2>For You 💌</h2>
        <p>
            Wishing you happiness, success, and lots of wonderful memories.
            May all your hard work pay off!
        </p>
    </div>

    <button onclick="startFireworks()">
        🎆 Fireworks
    </button>
</div>

<canvas id="fireworks"></canvas>

<script src="script.js"></script>
</body>
</html>
